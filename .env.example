# AXIOM runs on any engine. Pick ONE of these setups — or none, and operators paste their own key in the
# station (Engine panel). With no key anywhere, the station runs in demo mode with scripted replies.

# A) Provider-specific key (first one found wins). Optional <PREFIX>_MODELS overrides the fallback chain.
# XAI_API_KEY=            # XAI_MODELS=grok-4.5,grok-4,grok-3
# GROQ_API_KEY=           # GROQ_MODELS=llama-3.3-70b-versatile
# GEMINI_API_KEY=         # GEMINI_MODELS=gemini-2.5-flash   (GOOGLE_API_KEY also works)
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=      # ANTHROPIC_MODELS=claude-opus-5-5
# OPENROUTER_API_KEY=
# DEEPSEEK_API_KEY=
# MISTRAL_API_KEY=
# CEREBRAS_API_KEY=

# B) Generic: any key, provider auto-detected from its prefix (or set LLM_PROVIDER).
# LLM_API_KEY=
# LLM_PROVIDER=groq
# LLM_MODELS=llama-3.3-70b-versatile

# C) Any OpenAI-compatible endpoint (Ollama, LM Studio, Together, vLLM, Azure proxy, ...).
# LLM_API_KEY=anything
# LLM_BASE_URL=http://localhost:11434/v1
# LLM_MODELS=llama3.1
# LLM_NAME=Local Ollama

# Let visitors paste their own key in the station (proxied per request, never stored). Default: true.
# ALLOW_BYOK=true

# Chat requests per IP per minute (default 20).
# RATE_LIMIT_PER_MIN=20
