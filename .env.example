# AXIOM runs on any engine. Pick ONE of these setups — or none, and operators pick their own engine in the
# station (Engine panel). With no engine anywhere, the station runs in demo mode with scripted replies.

# A) Provider-specific key (first one found wins). Optional <PREFIX>_MODELS overrides the fallback chain.
#    Frontier APIs
# XAI_API_KEY=            # XAI_MODELS=grok-4.5,grok-4,grok-3
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=      # ANTHROPIC_MODELS=claude-opus-5-5
# GEMINI_API_KEY=         # GEMINI_MODELS=gemini-2.5-flash   (GOOGLE_API_KEY also works)
# MISTRAL_API_KEY=
# DEEPSEEK_API_KEY=
#    Open-model clouds (Llama, Qwen, DeepSeek, gpt-oss, Mistral… hosted for you)
# GROQ_API_KEY=           # GROQ_MODELS=llama-3.3-70b-versatile
# CEREBRAS_API_KEY=
# OPENROUTER_API_KEY=
# HF_TOKEN=               # Hugging Face Inference Providers (HUGGINGFACE_API_KEY also works)
#                         # HF_MODELS=meta-llama/Llama-3.3-70B-Instruct,Qwen/Qwen2.5-72B-Instruct
# TOGETHER_API_KEY=
# FIREWORKS_API_KEY=
# DEEPINFRA_API_KEY=
# SAMBANOVA_API_KEY=
# NOVITA_API_KEY=
# HYPERBOLIC_API_KEY=

# B) Open weights on the machine running this server (no key needed). The first URL found wins.
# OLLAMA_BASE_URL=http://localhost:11434/v1      # OLLAMA_MODELS=llama3.2,qwen2.5
# LMSTUDIO_BASE_URL=http://localhost:1234/v1
# VLLM_BASE_URL=http://localhost:8000/v1         # VLLM_API_KEY= if you started vLLM with --api-key
# LLAMACPP_BASE_URL=http://localhost:8080/v1
# LOCALAI_BASE_URL=http://localhost:8080/v1
# JAN_BASE_URL=http://localhost:1337/v1
# TEXTGEN_BASE_URL=http://localhost:5000/v1      # text-generation-webui with --api
# KOBOLDCPP_BASE_URL=http://localhost:5001/v1

# C) Generic: any provider by id, any OpenAI-compatible URL (TGI, SGLang, LiteLLM, TabbyAPI, MLX-LM, …).
# LLM_PROVIDER=ollama      # any id above: xai, groq, huggingface, ollama, lmstudio, vllm, custom, …
# LLM_API_KEY=             # provider auto-detected from the key prefix when LLM_PROVIDER is unset
# LLM_BASE_URL=http://localhost:11434/v1
# LLM_MODELS=llama3.2
# LLM_NAME=Local Ollama

# Let operators bring their own engine in the station (keys are proxied per request, never stored). Default: true.
# ALLOW_BYOK=true

# Let this server proxy operators' local runtimes (Ollama, LM Studio, vLLM…). Default: on in development,
# off in production. Leave it off on a public deployment: there the operator's browser calls their own
# runtime directly (they allow the site in the runtime's CORS settings). Setting it to true also lifts the
# private-network-only check, so only enable it on a server you alone use.
# ALLOW_LOCAL_ENGINES=false

# Chat requests per IP per minute (default 20).
# RATE_LIMIT_PER_MIN=20
